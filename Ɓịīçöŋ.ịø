def fetch_price(symbol):
    ticker = exchange.fetch_ticker(symbol)
    return ticker['last']

def place_stop_loss_order(symbol, side, amount, stop_price, limit_price):
    # Place a stop-limit order for stop-loss
    return exchange.create_order(
        symbol=symbol,
        type='stop_limit',
        side=side,
        amount=amount,
        price=limit_price,
        stop_price=stop_price
    )

